{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    }
  ],
  "buildCommand": "node release-public-build.mjs && node wawa-analytics-build.mjs wawa-10 .public-release && node seo-descriptions.mjs --root=.public-release",
  "outputDirectory": ".public-release"
}
